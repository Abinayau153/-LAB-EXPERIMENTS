#include<stdio.h>

int main()
{
    int n,i,time=0,remain,quantum;

    printf("Enter number of processes: ");
    scanf("%d",&n);

    int bt[n],rt[n];

    for(i=0;i<n;i++)
    {
        printf("Burst Time: ");
        scanf("%d",&bt[i]);
        rt[i]=bt[i];
    }

    printf("Enter Time Quantum: ");
    scanf("%d",&quantum);

    remain=n;

    while(remain!=0)
    {
        for(i=0;i<n;i++)
        {
            if(rt[i]>0)
            {
                if(rt[i]<=quantum)
                {
                    time+=rt[i];
                    rt[i]=0;
                    remain--;
                }
                else
                {
                    rt[i]-=quantum;
                    time+=quantum;
                }
            }
        }
    }

    printf("Total Time = %d",time);

    return 0;
}
