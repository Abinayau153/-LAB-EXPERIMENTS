#include <stdio.h>

#define N 5

int fork[N] = {0, 0, 0, 0, 0};

void philosopher(int p)
{
    int left = p;
    int right = (p + 1) % N;

    printf("\nPhilosopher %d is thinking.", p + 1);

    if (fork[left] == 0 && fork[right] == 0)
    {
        fork[left] = 1;
        fork[right] = 1;

        printf("\nPhilosopher %d picked up forks %d and %d.",
               p + 1, left + 1, right + 1);

        printf("\nPhilosopher %d is eating.", p + 1);

        fork[left] = 0;
        fork[right] = 0;

        printf("\nPhilosopher %d finished eating.", p + 1);
    }
    else
    {
        printf("\nPhilosopher %d is waiting for forks.", p + 1);
    }
}

int main()
{
    int i;

    printf("Dining Philosophers Problem\n");

    for (i = 0; i < N; i++)
    {
        philosopher(i);
    }

    return 0;
}
