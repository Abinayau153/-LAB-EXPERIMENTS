#include <stdio.h>

int main()
{
    int n,i,j,temp;

    printf("Enter number of processes: ");
    scanf("%d",&n);

    int p[n];

    for(i=0;i<n;i++)
    {
        printf("Priority P%d: ",i+1);
        scanf("%d",&p[i]);
    }

    for(i=0;i<n;i++)
    {
        for(j=i+1;j<n;j++)
        {
            if(p[i]>p[j])
            {
                temp=p[i];
                p[i]=p[j];
                p[j]=temp;
            }
        }
    }

    printf("\nPriority Order:\n");

    for(i=0;i<n;i++)
        printf("%d ",p[i]);

    return 0;
}
