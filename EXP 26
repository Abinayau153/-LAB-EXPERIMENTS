#include <stdio.h>
#include <stdlib.h>

int main()
{
    FILE *fp;
    char data[100];

    /* Create and Write */
    fp = fopen("file.txt", "w");

    if (fp == NULL)
    {
        printf("Unable to create file.\n");
        return 1;
    }

    fprintf(fp, "Operating System File Management");
    fclose(fp);

    printf("File created and written successfully.\n");

    /* Read */
    fp = fopen("file.txt", "r");

    if (fp == NULL)
    {
        printf("Unable to open file.\n");
        return 1;
    }

    fgets(data, sizeof(data), fp);

    printf("\nFile content: %s\n", data);

    fclose(fp);

    /* Append */
    fp = fopen("file.txt", "a");

    fprintf(fp, "\nFile operations are performed successfully.");
    fclose(fp);

    printf("\nData appended successfully.\n");

    /* Delete */
    if (remove("file.txt") == 0)
        printf("File deleted successfully.\n");
    else
        printf("File deletion failed.\n");

    return 0;
}
