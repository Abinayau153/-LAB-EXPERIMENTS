#include <stdio.h>

int main()
{
    int pages[50], frames[10], time[10];
    int n, f, i, j, k;
    int counter = 0, pageFaults = 0;
    int found, pos, min;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter reference string:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &f);

    for(i = 0; i < f; i++)
    {
        frames[i] = -1;
        time[i] = 0;
    }

    for(i = 0; i < n; i++)
    {
        found = 0;

        for(j = 0; j < f; j++)
        {
            if(frames[j] == pages[i])
            {
                counter++;
                time[j] = counter;
                found = 1;
                break;
            }
        }

        if(!found)
        {
            pageFaults++;
            counter++;

            pos = -1;

            for(j = 0; j < f; j++)
            {
                if(frames[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            if(pos == -1)
            {
                min = time[0];
                pos = 0;

                for(k = 1; k < f; k++)
                {
                    if(time[k] < min)
                    {
                        min = time[k];
                        pos = k;
                    }
                }
            }

            frames[pos] = pages[i];
            time[pos] = counter;
        }

        printf("Page %d: ", pages[i]);
        for(j = 0; j < f; j++)
            printf("%d ", frames[j]);
        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", pageFaults);

    return 0;
}
